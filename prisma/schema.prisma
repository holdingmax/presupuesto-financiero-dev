// Presupuesto y Ejecución Financiera — Toolbox / HoldingMax
// Modelo de datos validado con Leticia (ver resumen en README.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  GERENTE
  FINANZAS
}

enum EstadoPresupuesto {
  ABIERTO
  EN_REVISION
  VALIDADO
}

enum EstadoEjecucion {
  ABIERTA
  CERRADA
}

// Empresa o unidad de negocio. El CUIT es un atributo, no una clave,
// porque un mismo CUIT puede corresponder a más de una unidad de negocio
// (ej. CREAR = Fredy + Mantenor) y una unidad puede tener varios CUIT (ej. Fredy).
model Empresa {
  id        String   @id @default(uuid())
  nombre    String   // ej: "Havanna", "Fredy Publicidad", "Brillante", "HWC"
  cuit      String?
  activo    Boolean  @default(true)
  // Unidades de negocio (de UNIDADES_NEGOCIO, lib/unidadesNegocio.ts) que
  // pertenecen a esta empresa: el Reporte suma como REAL de la empresa los
  // movimientos de CUALQUIER extracto cuya unidad esté acá. Una unidad pertenece
  // a UNA sola empresa (lo controla la pantalla /admin/unidades-negocio). Vacío =
  // la empresa no tiene unidad propia (ej. Gold Seguridad, razón social).
  unidadesNegocio String[] @default([])
  createdAt DateTime @default(now())

  presupuestos PresupuestoMensual[]
  usuarios     UsuarioEmpresa[]
  valoresManualesReporte ValorManualReporte[]
  filasExtraReporte      FilaExtraReporte[]
  cuentasBancarias       CuentaBancaria[]

  @@index([cuit])
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String? // null = todavía no tiene contraseña asignada, no puede loguearse
  debeActualizarPassword Boolean @default(false) // true tras alta o reset por un admin: fuerza pasar por /cuenta antes de cualquier otra pantalla
  rol          Rol      @default(GERENTE)
  activo       Boolean  @default(true)
  // Permiso GLOBAL de operar Ejecución (subir, clasificar, asignar). ADMIN opera
  // siempre. Lo da un ADMIN desde /admin/usuarios; ninguna migración se lo da a nadie.
  operaEjecucion Boolean @default(false)
  createdAt    DateTime @default(now())

  empresas UsuarioEmpresa[]
  sesiones Sesion[]
  valoresManualesReporte ValorManualReporte[]
  filasExtraReporte      FilaExtraReporte[]
}

// Sesión en base (no JWT sin estado): borrar la fila invalida esa sesión al
// instante, lo que da un logout real sin necesidad de un blocklist aparte.
model Sesion {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([usuarioId])
}

// Permisos: un usuario puede tener acceso a varias empresas/UN.
// Un ADMIN no necesita filas acá — ve todo (se resuelve en la capa de autorización).
model UsuarioEmpresa {
  usuarioId String
  empresaId String
  // Independiente del acceso en sí: ver una empresa no implica poder operar
  // su Ejecución (subir extracto, reclasificar, cerrar semana). Por fila
  // (usuario+empresa), no un rol global — la misma persona puede operar
  // algunas empresas y solo consultar otras.
  puedeOperarEjecucion Boolean @default(false)
  // Permiso análogo a puedeOperarEjecucion, pero para el paso de revisión de
  // Presupuesto (ver EstadoPresupuesto.EN_REVISION): solo quien tiene esto en
  // true puede agregar/editar/borrar líneas de un presupuesto EN_REVISION.
  // Mismo criterio: por fila usuario+empresa, no un rol global.
  puedeRevisarPresupuesto Boolean @default(false)
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@id([usuarioId, empresaId])
}

// Presupuesto de una empresa/UN para un mes determinado.
// Una vez VALIDADO no se edita más: cualquier corrección se carga
// como parte del período siguiente (regla explícita de Vigo).
model PresupuestoMensual {
  id               String            @id @default(uuid())
  empresaId        String
  periodo          String            // formato "YYYY-MM", ej "2026-09"
  estado           EstadoPresupuesto @default(ABIERTO)
  fechaValidacion  DateTime?
  validadoPorId    String?
  // Se pone en true la primera vez que el revisor toca algo (agregar/editar/
  // borrar línea o desglose) mientras el presupuesto está EN_REVISION — nunca
  // se resetea a false (una fila de PresupuestoMensual es por período, no se
  // reutiliza). Es el aviso mínimo que ve el gerente: "Kike hizo cambios",
  // sin detalle línea por línea.
  fueModificadoPorRevisor Boolean @default(false)
  // El revisor la pone en true con "Terminé de revisar" — recién ahí el
  // gerente puede confirmarVersionFinal. Cualquier mutación posterior del
  // revisor mientras sigue EN_REVISION la vuelve a false (ver
  // marcarComoModificadoSiEnRevision en actions.ts): si Kike sigue tocando
  // algo después de haber marcado "terminé", hay que pedirle que confirme de
  // nuevo antes de que el gerente pueda cerrar el presupuesto.
  revisionCompletada      Boolean @default(false)
  // true = la versión final no la confirmó el gerente sino un ADMIN o un FINANZAS revisor
  // "en nombre del gerente" (confirmarEnNombreDelGerente). validadoPorId sigue siendo quién
  // apretó el botón; el motivo (obligatorio, mínimo 10 caracteres) queda acá. En los
  // presupuestos validados antes de esta regla queda false/null (no se reconstruye).
  confirmadoEnNombreDeGerente Boolean @default(false)
  motivoConfirmacionEnNombre  String?
  createdAt        DateTime          @default(now())

  empresa   Empresa              @relation(fields: [empresaId], references: [id])
  lineas    LineaPresupuesto[]
  semanas   EjecucionSemanal[]
  pedidosCambios PedidoCambiosPresupuesto[]

  @@unique([empresaId, periodo])
}

// Pedido de cambios del revisor al gerente mientras el presupuesto está
// EN_REVISION: devuelve el presupuesto a ABIERTO y deja constancia acá. Una
// fila por pedido (se puede repetir las veces que haga falta, el historial no
// se pisa); el vigente es el más reciente. solicitadoPorId sin FK a Usuario, igual
// que PresupuestoMensual.validadoPorId. El mensaje es obligatorio y se limita
// a 1000 caracteres en el servidor (no en la base).
model PedidoCambiosPresupuesto {
  id              String   @id @default(uuid())
  presupuestoId   String
  mensaje         String
  solicitadoPorId String
  createdAt       DateTime @default(now())

  presupuesto PresupuestoMensual @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@index([presupuestoId, createdAt])
}

// Concepto (texto libre por ahora — todavía no hay un listado curado de
// conceptos válidos) es el campo estructurado pensado para más adelante
// cruzarse contra listados auxiliares y automatizar la clasificación.
// Detalle sigue existiendo como aclaración libre, en un rol secundario.
// Reglas de Vigo: importe no puede ser 0 ni vacío; clasificacion no puede estar vacía.
// El nivel de apertura del "detalle" queda a criterio de cada gerente.
model LineaPresupuesto {
  id              String   @id @default(uuid())
  presupuestoId   String
  concepto        String
  detalle         String
  importe         Decimal  @db.Decimal(18, 2)
  clasificacion   String   // rubro: sueldos, impuestos, proveedores, gasto bancario, etc.
  clasificacion2  String?  // sub-rubro opcional, por si algún gerente lo necesita
  createdAt       DateTime @default(now())

  presupuesto PresupuestoMensual @relation(fields: [presupuestoId], references: [id])
  adjuntos    Adjunto[]
  desglose    LineaPresupuestoDesglose[]

  @@index([presupuestoId])
}

// Apertura opcional de una LineaPresupuesto en varios conceptos (solo para
// clasificaciones habilitadas — ver esElegibleParaDesglose en lib/clasificaciones.ts).
// La suma de sus importes tiene que dar exactamente el importe de la línea
// padre (se valida en guardarDesglose); la línea padre sigue siendo la única
// fuente de verdad para el total del presupuesto — el desglose es anotación
// de detalle, nunca se suma aparte.
model LineaPresupuestoDesglose {
  id                 String   @id @default(uuid())
  lineaPresupuestoId String
  detalle            String
  importe            Decimal  @db.Decimal(18, 2)
  createdAt          DateTime @default(now())

  lineaPresupuesto LineaPresupuesto @relation(fields: [lineaPresupuestoId], references: [id], onDelete: Cascade)

  @@index([lineaPresupuestoId])
}

// Ejecución semanal de un período, de todo el holding. Una vez CERRADA, no se
// edita retroactivamente — cualquier corrección entra en la semana siguiente.
model EjecucionSemanal {
  id             String          @id @default(uuid())
  periodo        String          // "AAAA-MM": la semana es del período, de todo el holding
  // Origen histórico: empresa en la que se cargó la semana antes de Ejecución
  // global. NULL en las semanas globales.
  presupuestoId  String?
  numeroSemana   Int
  estado         EstadoEjecucion @default(ABIERTA)
  fechaCierre    DateTime?
  cerradoPorId   String?
  createdAt      DateTime        @default(now())

  // onDelete explícito: en una relación opcional Prisma asume SetNull y el diff
  // querría recrear la FK.
  presupuesto PresupuestoMensual? @relation(fields: [presupuestoId], references: [id], onDelete: Restrict)
  movimientos MovimientoBancario[]

  @@unique([periodo, numeroSemana])
}

// Un movimiento importado desde un extracto bancario, ya imputado
// (clasificado y asignado a una unidad de negocio) vía el panel de imputación.
model MovimientoBancario {
  id              String   @id @default(uuid())
  ejecucionId     String
  fecha           DateTime
  nroReferencia   String?
  causal          String?
  concepto        String
  importe         Decimal  @db.Decimal(18, 2)
  saldo           Decimal? @db.Decimal(18, 2)
  bancoYCuenta    String   // ej "MACRO 599", "GALICIA 891"
  // Moneda del movimiento: código ISO ("ARS", "PEN", "USD"...). Todo lo cargado hasta ahora es pesos
  // argentinos, de ahí el default. El Real del Reporte, los chequeos de suma cero y la continuidad de
  // saldo no mezclan monedas (lib/conteoMovimientos.ts: MONEDA_PREDETERMINADA).
  moneda          String   @default("ARS")
  clasificacion   String   // ej COBRANZAS, PROV Y SERV, SUELDOS, IMP Y PREVISIONALES...
  clasificacion2  String?
  // true mientras `clasificacion` fue propuesta por el sistema (motor de
  // leyenda en lib/clasificaciones.ts, o los cruces aplicarCruceLiquidacionFinal/
  // aplicarCruceChequeIva en ejecucion/actions.ts) y todavía no pasó por la
  // pantalla de "confirmar en lote" ni fue tocada a mano. Se limpia en
  // actualizarMovimiento (CUALQUIER edición manual de clasificacion cuenta como
  // confirmación, incluso reelegir el mismo valor — un <select> nativo no
  // dispara onChange si el valor no cambia, así que esto no puede depender de
  // comparar contra el valor anterior) y en confirmarClasificacionesEnLote
  // (aceptar tal cual, sin tocar el valor). Default false: valor explícito del
  // archivo, "SIN CLASIFICAR" (no es una sugerencia, es un vacío) y cualquier
  // fila ya existente antes de este campo quedan como ya confirmadas.
  sugeridaPorSistema Boolean @default(false)
  // true solo cuando aplicarCruceChequeIva clasificó esta fila usando una
  // ChequeIvaReferencia marcada duplicadoAmbiguo=true (más de un cheque real
  // con el mismo N°+importe en la planilla de Macchi). La pantalla de lote la
  // excluye del botón "Confirmar todas" del grupo — esas quedan para
  // confirmación individual únicamente. Específico de este cruce puntual, no
  // un estado genérico de ambigüedad.
  chequeIvaAmbiguo   Boolean @default(false)
  // true mientras `unidadNegocio` fue propuesta por el sistema a partir de la
  // cuenta bancaria (proponerUnidadPorCuenta en lib/unidadesNegocio.ts) porque
  // el archivo no traía unidad — independiente de sugeridaPorSistema (que es
  // solo de la clasificación). Se limpia en actualizarMovimiento solo si la
  // unidad CAMBIÓ de verdad, y en confirmarUnidadesEnLote (aceptar tal cual).
  // Default false: unidad explícita del archivo y filas previas a este campo
  // quedan como ya confirmadas.
  unidadSugeridaPorSistema Boolean @default(false)
  unidadNegocio   String   // puede diferir de la empresa dueña de la cuenta bancaria
  detalle         String?
  detalle2        String?
  // No-destructivo: excluye la línea de cálculos/reportes/chequeos sin borrar
  // ni modificar el resto de sus datos. Default false para no afectar ninguna
  // fila existente al migrar.
  ignorado        Boolean  @default(false)
  createdAt       DateTime @default(now())

  ejecucion EjecucionSemanal @relation(fields: [ejecucionId], references: [id])
  adjuntos  Adjunto[]
  desglose  MovimientoBancarioDesglose[]

  @@index([ejecucionId])
  @@index([unidadNegocio])
  @@index([clasificacion])
}

// Apertura opcional de un MovimientoBancario en varias unidades de negocio
// (solo para clasificaciones habilitadas — ver esElegibleParaDesgloseEjecucion
// en lib/clasificaciones.ts). Por ahora es ANOTACIÓN, mismo criterio que
// LineaPresupuestoDesglose: el movimiento padre sigue siendo la única fuente
// de verdad para cualquier cálculo existente (chequeos de suma-cero,
// totales de Ejecución, continuidad de saldo) — nada lee esta tabla todavía
// para sumar nada. unidadNegocio (no clasificacion) es una asunción de
// trabajo, no una confirmación de Macchi — respaldada por dato real
// (2026-09-02): en producción "EXPENSAS" tiene 182 filas como unidadNegocio
// y 0 como clasificacion. Los 3 campos propios (movimientoId, unidadNegocio,
// importe) ya alcanzan para un futuro reporte "por unidad de negocio" sin
// agregar columnas — promoverla a fuente real el día de mañana es agregar
// código que la lea, no una migración. Completamente independiente del
// MovimientoBancario.unidadNegocio propio de la fila — ver el comentario en
// ejecucion/actions.ts (guardarDesgloseMovimiento) sobre por qué no se pisan.
model MovimientoBancarioDesglose {
  id            String   @id @default(uuid())
  movimientoId  String
  unidadNegocio String
  importe       Decimal  @db.Decimal(18, 2)
  createdAt     DateTime @default(now())

  movimiento MovimientoBancario @relation(fields: [movimientoId], references: [id], onDelete: Cascade)

  @@index([movimientoId])
}

// Snapshot de PAGOS_2025-2026.xlsx (planilla real de Macchi, no ligada a una
// sola empresa — cubre todo el holding). Se reemplaza COMPLETA en cada carga
// desde /admin (ver subirPagoReferencia) — no acumula entre cargas, porque la
// planilla de origen ya es su propia versión consolidada/corregida. Usada
// como cruce en subirExtracto para discriminar "Liquidación final" de
// "Sueldos" cuando la leyenda bancaria por sí sola no alcanza (ver
// lib/pagoReferencia.ts). fecha+importe es la clave de matching que ya usa
// Macchi a mano — @@index para esa consulta.
model PagoReferencia {
  id                 String   @id @default(uuid())
  fecha              DateTime
  proveedor          String
  leyenda            String
  unidadNegocio      String
  importe            Decimal  @db.Decimal(18, 2)
  esLiquidacionFinal Boolean
  createdAt          DateTime @default(now())

  @@index([fecha, importe])
}

// Snapshot de IVA_NUEVO4.xlsx (hoja "operaciones_cheques", planilla real de
// Macchi) — mismo patrón que PagoReferencia: se reemplaza COMPLETA en cada
// carga desde /admin, no acumula. Usada en subirExtracto para discriminar
// "IVA" de "CH DIFERIDOS IVA" en movimientos "CHEQUE P/CAMARA", cruzando
// por N° de cheque + importe contra MovimientoBancario.nroReferencia (ver
// lib/chequeIvaReferencia.ts y aplicarCruceChequeIva en ejecucion/actions.ts).
// "IVA"/"CH DIFERIDOS IVA" son categorías DISTINTAS de "CHEQUES DIFERIDOS"
// (ya existente, otro significado) — no fusionar.
model ChequeIvaReferencia {
  id               String   @id @default(uuid())
  fecha            DateTime // negociación, ya con forward-fill aplicado al parsear
  empresa          String
  razonSocial      String
  numeroCheque     Int
  banco            String
  importeCh        Decimal  @db.Decimal(18, 2)
  // La planilla trae mayormente una tasa (~0,02-0,03), pero algunas filas
  // (5 de 8382, validado 2026-09) traen directamente un monto en pesos en
  // esta columna en vez de la tasa — inconsistencia de carga de la fuente,
  // no un error de parseo. Precisión generosa para no romper el import;
  // este campo es anotación, no participa del cruce (ver lib/chequeIvaReferencia.ts).
  comision         Decimal? @db.Decimal(14, 4)
  aIngresar        Decimal? @db.Decimal(18, 2)
  // true si esta fila "ganó" el desempate entre varias filas del archivo
  // fuente con el mismo (numeroCheque, importeCh) — se usa igual para el
  // cruce, pero queda marcada para una eventual revisión manual (ver
  // lib/chequeIvaReferencia.ts). El sistema no la resuelve solo.
  duplicadoAmbiguo Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([numeroCheque, importeCh])
}

// Comprobante/imagen de respaldo. Puede colgar de una línea de presupuesto
// o de un movimiento bancario (el "ícono de ojo" que mencionó Vigo).
model Adjunto {
  id                  String   @id @default(uuid())
  urlArchivo          String
  lineaPresupuestoId  String?
  movimientoId        String?
  createdAt           DateTime @default(now())

  lineaPresupuesto LineaPresupuesto?   @relation(fields: [lineaPresupuestoId], references: [id])
  movimiento       MovimientoBancario? @relation(fields: [movimientoId], references: [id])
}

enum ColumnaReporte {
  PRESUPUESTADO
  REAL
}

// Valores que en la planilla de Macchi se tipean a mano (Disponibilidades,
// Resultado FCI, reservas, Capital de trabajo cuando se reemplaza, etc.).
// filaClave = clave de la fila de la plantilla (lib/reporte/plantillas), p. ej.
// "cx.banco". Uno por empresa, período, fila y columna. Vacío = no hay fila.
model ValorManualReporte {
  id           String         @id @default(uuid())
  empresaId    String
  periodo      String         // "YYYY-MM"
  filaClave    String
  columna      ColumnaReporte
  importe      Decimal        @db.Decimal(18, 2)
  nota         String?        // la cuenta tal como se tipeó ("321235,44+17755,22") o una aclaración
  cargadoPorId String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  empresa    Empresa @relation(fields: [empresaId], references: [id])
  cargadoPor Usuario @relation(fields: [cargadoPorId], references: [id])

  @@unique([empresaId, periodo, filaClave, columna])
}

// Cuentas bancarias de cada empresa, para el selector de "Subir extracto" (plan:
// docs/lector_bancos_plan.md §4). Se cargan a mano desde /admin/cuentas-bancarias;
// se desactivan (activa=false), no se borran. `nombre` es el canónico y coincide con
// MovimientoBancario.bancoYCuenta y con las claves de UNIDAD_POR_CUENTA ("MACRO 599").
// `terminacion` = últimos dígitos del número de cuenta, para validar el del archivo.
model CuentaBancaria {
  id          String   @id @default(uuid())
  empresaId   String?  // empresa TITULAR (opcional): solo para el aviso de CUIT
  nombre      String   @unique // canónico, único global, el mismo que bancoYCuenta: "MACRO 599"
  banco       String   // MACRO | GALICIA | FRANCES | BNA | SANTANDER | BSE
  terminacion String   // dígitos finales con los que se valida el número del archivo: "599"
  // Moneda por defecto de los movimientos de la cuenta (código ISO). Hoy ningún lector la usa todavía.
  moneda      String   @default("ARS")
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: Restrict)
}

// Bloque del Reporte en el que va una fila extra (las que agrega ADMIN/FINANZAS mientras revisa).
enum BloqueFilaExtra {
  INGRESOS
  EGRESOS
  ABAJO
}

// Fila extra del Reporte por plantilla: la agrega ADMIN/FINANZAS a UNA empresa (lib/reporte/filasExtra.ts).
// Se muestra desde `desdePeriodo` en adelante (y hasta `hastaPeriodo` inclusive, si lo tiene; todavía sin
// pantalla para fijarlo). Es siempre manual: Presupuestado y Real viven en ValorManualReporte con
// filaClave = "extra." + id (el id, no el nombre: renombrar no rompe nada). Se borra solo si no tiene
// valores. `nombreClave` = texto normalizado (lib/texto.ts) para no repetir nombres dentro de la empresa.
model FilaExtraReporte {
  id           String          @id @default(uuid())
  empresaId    String
  bloque       BloqueFilaExtra
  nombre       String
  nombreClave  String
  desdePeriodo String          // "YYYY-MM"
  hastaPeriodo String?         // "YYYY-MM", inclusive; null = sin fin
  creadoPorId  String
  createdAt    DateTime        @default(now())

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])

  @@unique([empresaId, nombreClave])
  @@index([empresaId, desdePeriodo])
}
