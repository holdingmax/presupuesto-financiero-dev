# Cadena de conexión de Neon (Postgres serverless).
# Se obtiene desde el dashboard de Neon > Connection Details.
DATABASE_URL="postgresql://usuario:password@ep-xxxxx.neon.tech/presupuesto_financiero?sslmode=require"

# Clave de firma de las cookies de sesión (jose). Generar con: openssl rand -base64 32
# No reutilizar la misma clave entre ambientes (prod/testing/local).
SESSION_SECRET="reemplazar-por-un-secreto-real"

# Contraseña inicial del admin (Leticia), usada solo por prisma/seed.ts — no la lee
# nada en runtime. Solo hace falta si vas a correr `npm run db:seed` en este ambiente.
SEED_ADMIN_PASSWORD="reemplazar-por-una-contraseña-inicial"

# --- Recuperación de contraseña ("¿Olvidaste tu contraseña?") ---
# Apagado por defecto: el enlace del login y las pantallas /olvide y /restablecer solo existen si vale "true".
RECUPERACION_ACTIVA="false"
# Mail por SMTP (nodemailer) desde la casilla del remitente. Puerto 465 = TLS directo; 587 = STARTTLS.
# Si falta alguna, el pedido responde igual pero no se envía nada (queda un aviso genérico en el log).
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
MAIL_REMITENTE=""
# URL pública de la app, sin barra final (el enlace del mail se arma con esto; nunca con el Host del pedido).
APP_URL_PUBLICA=""
# Orden de los encabezados para detectar la IP del cliente (límite de pedidos). Opcional: ese es el orden por defecto.
# IP_CLIENTE_ENCABEZADOS="cf-connecting-ip,true-client-ip,x-forwarded-for"
